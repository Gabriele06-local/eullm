+static void ggml_backend_sched_prefetch_init(ggml_backend_sched_t sched) {
+    const char * on = getenv("LLAMA_MOE_PREFETCH");
+    if (on == NULL || atoi(on) == 0) {
+        return;
+    }
+    if (sched->n_copies > 1) {
+        fprintf(stderr, "moe prefetch: off, the scheduler keeps several copies of the graph\n");
+        return;
+    }
+    ggml_backend_dev_t gpu = NULL;
+    int n_gpus = 0;
+    for (int b = 0; b < sched->n_backends; b++) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(sched->backends[b]);
+        if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+            gpu = dev;
+            n_gpus++;
+        }
+    }
+    if (n_gpus == 0) {
+        fprintf(stderr, "moe prefetch: off, no GPU\n");
+        return;
+    }
+    if (n_gpus > 1) {
+        // the copy stream would have to follow each split to its device
+        fprintf(stderr, "moe prefetch: off, it supports one GPU\n");
+        return;
+    }
+    // other backends hold on to what an asynchronous copy or an event takes until the next full
+    // synchronization, which comes once per graph: Vulkan a new event per record, Metal a copy
+    // of the host data per copy
+    const char * reg = ggml_backend_reg_name(ggml_backend_dev_backend_reg(gpu));
+    if (strcmp(reg, "CUDA") != 0) {
+        fprintf(stderr, "moe prefetch: off, it is written for CUDA, not %s\n", reg);
+        return;
+    }
+    auto * pf = new ggml_backend_sched_prefetch();
+    const char * min_tokens = getenv("LLAMA_MOE_PREFETCH_MIN_TOKENS");
+    pf->min_tokens = min_tokens != NULL ? std::max(1, atoi(min_tokens)) : 512;
+    const char * slots = getenv("LLAMA_MOE_PREFETCH_SLOTS");
+    pf->n_slots = slots != NULL ? std::min(std::max(atoi(slots), 2), GGML_SCHED_PREFETCH_MAX_SLOTS) : 2;
+    pf->backend_id = -1;
+    sched->prefetch = pf;
+}
+
+static void ggml_backend_sched_prefetch_free(ggml_backend_sched_t sched) {
+    ggml_backend_sched_prefetch * pf = sched->prefetch;
+    if (pf == NULL) {
+        return;
+    }
+    if (pf->copy_backend != NULL) {
+        ggml_backend_synchronize(pf->copy_backend);
+    }
+    for (int s = 0; s < GGML_SCHED_PREFETCH_MAX_SLOTS; s++) {
+        ggml_backend_event_free(pf->copied[s]);
+        ggml_backend_event_free(pf->freed[s]);
+    }
+    ggml_backend_buffer_free(pf->slots);
+    ggml_backend_free(pf->copy_backend);
+    delete pf;
+    sched->prefetch = NULL;
+}
+
+// turns it off for good, said once, and gives the slots' VRAM back
+static void ggml_backend_sched_prefetch_fail(ggml_backend_sched_t sched, const char * why) {
+    ggml_backend_sched_prefetch * pf = sched->prefetch;
+    if (pf->slots != NULL) {
+        // the previous graph may still be reading the slots, or filling them
+        ggml_backend_synchronize(sched->backends[pf->backend_id]);
+        ggml_backend_synchronize(pf->copy_backend);
+        ggml_backend_buffer_free(pf->slots);
+        pf->slots = NULL;
+    }
+    pf->failed = true;
+    pf->inputs.clear();
+    pf->placed = false;
+    fprintf(stderr, "moe prefetch: off, %s\n", why);
+}
+
+// whether the experts `src` of `node`, copied to backend `backend_id` for split `split_id`, are copied ahead into a slot
+static bool ggml_backend_sched_prefetch_wants(ggml_backend_sched_t sched, const struct ggml_tensor * node, const struct ggml_tensor * src, int backend_id, int split_id) {
+    ggml_backend_sched_prefetch * pf = sched->prefetch;
+    if (pf == NULL || pf->failed || node->op != GGML_OP_MUL_MAT_ID || src != node->src[0]) {
+        return false;
+    }
+    if (src->buffer == NULL || ggml_backend_buffer_get_usage(src->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS ||
+        !ggml_backend_buffer_is_host(src->buffer) || !ggml_is_contiguous(src)) {
+        return false;
+    }
+    if (node->src[2]->ne[1] < pf->min_tokens) {
+        return false;
+    }
+    ggml_backend_dev_t dev = ggml_backend_get_device(sched->backends[backend_id]);
+    if (pf->backend_id != -1 ? pf->backend_id != backend_id : ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU) {
+        return false;
+    }
+    if (ggml_backend_buffer_get_type(src->buffer) != ggml_backend_dev_host_buffer_type(dev)) {
+        // from pageable memory the copy into a slot holds the host until the slot's previous reader
+        // has run, before the split in between is queued: the copies and the splits alternate again
+        ggml_backend_sched_prefetch_fail(sched, "the experts are not in the GPU's pinned host memory (load the model without mmap)");
+        return false;
+    }
+    // a split's inputs are all copied before it runs, each in a slot of its own
+    int in_split = 0;
+    for (auto it = pf->inputs.rbegin(); it != pf->inputs.rend() && it->split_id == split_id; ++it) {
+        in_split++;
+    }
+    return in_split < pf->n_slots;
+}
+
+// puts the current graph's staged copies in their slots, allocating the slots the first time; after the split, before ggml-alloc
+static void ggml_backend_sched_prefetch_place(ggml_backend_sched_t sched) {
+    ggml_backend_sched_prefetch * pf = sched->prefetch;
+    if (pf == NULL || pf->failed || pf->inputs.empty()) {
+        return;
+    }
+    if (pf->reused) {
+        // the slot of a copy read by two splits may be filled again between them: copied the usual way
+        pf->inputs.clear();
+        return;
+    }
+
+    ggml_backend_t backend = sched->backends[pf->backend_id];
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    ggml_backend_buffer_type_t buft = ggml_backend_get_default_buffer_type(backend);
+
+    if (pf->copy_backend == NULL) {
+        struct ggml_backend_dev_props props;
+        ggml_backend_dev_get_props(dev, &props);
+        if (!props.caps.async || !props.caps.events) {
+            ggml_backend_sched_prefetch_fail(sched, "the GPU backend has no asynchronous copies or no events");
+            return;
+        }
+        pf->copy_backend = ggml_backend_dev_init(dev, NULL);
+        if (pf->copy_backend == NULL) {
+            ggml_backend_sched_prefetch_fail(sched, "no second stream on the GPU");
+            return;
+        }
+        for (int s = 0; s < pf->n_slots; s++) {
+            pf->copied[s] = ggml_backend_event_new(dev);
+            pf->freed[s]  = ggml_backend_event_new(dev);
+            if (pf->copied[s] == NULL || pf->freed[s] == NULL) {
+                ggml_backend_sched_prefetch_fail(sched, "no events on the GPU");
+                return;
+            }
+        }
+    }
+
+    // a slot holds the largest copy with its padding, which the kernels that read past a copy's
+    // end (MMQ, MMVQ) clear themselves in a compute buffer, whatever an earlier copy left there
+    const size_t align = ggml_backend_buft_get_alignment(buft);
+    size_t slot_size = 0;
+    for (const auto & in : pf->inputs) {
+        slot_size = std::max(slot_size, GGML_PAD(ggml_backend_buft_get_alloc_size(buft, in.input_cpy), align));
+    }
+
+    if (pf->slots == NULL || pf->slot_size < slot_size) {
+        // VRAM nothing else counted on: a compute allocates as it goes (the GPU's memory pool,
+        // cuBLAS) and aborts when it finds none, so the slots leave it room or are not made
+        size_t free_vram  = 0;
+        size_t total_vram = 0;
+        ggml_backend_dev_memory(dev, &free_vram, &total_vram);
+        const size_t held = pf->slots != NULL ? ggml_backend_buffer_get_size(pf->slots) : 0;
+        const size_t kept = std::max((size_t) 512 << 20, total_vram / 20);
+        if (free_vram + held < slot_size * pf->n_slots + kept) {
+            char why[192];
+            snprintf(why, sizeof(why), "%d slots of %.1f MiB and %.0f MiB left for the compute need %.0f MiB of free VRAM, %.0f MiB free",
+                pf->n_slots, slot_size / 1048576.0, kept / 1048576.0, (slot_size * pf->n_slots + kept) / 1048576.0, (free_vram + held) / 1048576.0);
+            ggml_backend_sched_prefetch_fail(sched, why);
+            return;
+        }
+        // nothing may still be reading the slots, or writing them
+        ggml_backend_synchronize(backend);
+        ggml_backend_synchronize(pf->copy_backend);
+        ggml_backend_buffer_free(pf->slots);
+        pf->slots = ggml_backend_buft_alloc_buffer(buft, slot_size * pf->n_slots);
+        if (pf->slots == NULL) {
+            char why[128];
+            snprintf(why, sizeof(why), "no room in VRAM for %d slots of %.1f MiB", pf->n_slots, slot_size / 1048576.0);
+            ggml_backend_sched_prefetch_fail(sched, why);
+            return;
+        }
+        // compute usage: placing a tensor writes nothing to the buffer, and the kernels clear the padding
+        ggml_backend_buffer_set_usage(pf->slots, GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+        pf->slot_size = slot_size;
+        fprintf(stderr, "moe prefetch: on, %d slots of %.1f MiB, for MUL_MAT_ID of %d tokens or more\n",
+            pf->n_slots, slot_size / 1048576.0, pf->min_tokens);
+    }
+
+    char * base = (char *) ggml_backend_buffer_get_base(pf->slots);
+    for (size_t i = 0; i < pf->inputs.size(); i++) {
+        ggml_backend_sched_prefetch_input & in = pf->inputs[i];
+        // consecutive inputs, the ones of a split among them, take different slots
+        in.slot = (int) (i % pf->n_slots);
+        if (ggml_backend_tensor_alloc(pf->slots, in.input_cpy, base + in.slot * pf->slot_size) != GGML_STATUS_SUCCESS) {
+            // the copies placed so far are taken out again, for ggml-alloc to place in the compute buffer
+            for (size_t j = 0; j <= i; j++) {
+                pf->inputs[j].input_cpy->buffer = NULL;
+                pf->inputs[j].input_cpy->data   = NULL;
+            }
+            ggml_backend_sched_prefetch_fail(sched, "a copy could not be placed in its slot");
+            return;
+        }
+    }
+    pf->placed = true;
+}
+
+// queues the copy of a staged input on the copy stream, once the slot's previous reader has run
+static void ggml_backend_sched_prefetch_issue(ggml_backend_sched_prefetch * pf, const ggml_backend_sched_prefetch_input * in) {
+    ggml_backend_event_wait(pf->copy_backend, pf->freed[in->slot]);
+    ggml_backend_tensor_set_async(pf->copy_backend, in->input_cpy, in->input->data, 0, ggml_nbytes(in->input_cpy));
+    ggml_backend_event_record(pf->copied[in->slot], pf->copy_backend);
+}
