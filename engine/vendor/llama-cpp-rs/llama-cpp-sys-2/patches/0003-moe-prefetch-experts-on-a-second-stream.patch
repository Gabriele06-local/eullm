     void * callback_moe_cache_user_data;
     ggml_backend_t moe_cache_backend;
 
+    struct ggml_backend_sched_prefetch * prefetch; // EuLLM, NULL unless LLAMA_MOE_PREFETCH is set
+
     char * context_buffer;
     size_t context_buffer_size;
 
@@ -1019,6 +1067,191 @@ static void ggml_backend_sched_split_inputs_grow(struct ggml_backend_sched_split
