-// queues the copy of a staged input on the copy stream, once the slot's previous reader has run
-static void ggml_backend_sched_prefetch_issue(ggml_backend_sched_prefetch * pf, const ggml_backend_sched_prefetch_input * in) {
+// `size` bytes of a tensor's data from `offset` on, as a tensor of their own, for a copy of part of it
+static struct ggml_tensor ggml_backend_sched_prefetch_bytes(const struct ggml_tensor * t, size_t offset, size_t size) {
+    struct ggml_tensor v = {};
+    v.type   = GGML_TYPE_I8;
+    v.buffer = t->buffer;
+    v.data   = (char *) t->data + offset;
+    v.ne[0]  = (int64_t) size;
+    v.ne[1]  = v.ne[2] = v.ne[3] = 1;
+    v.nb[0]  = 1;
+    v.nb[1]  = v.nb[2] = v.nb[3] = size;
+    return v;
+}
+
+// queues the copy of a staged input: over the bus on the copy stream, once the slot's previous reader
+// has run, and the experts the expert cache holds from its slots in VRAM on the GPU's stream `gpu`,
+// where the slot's previous reader is queued already
+static void ggml_backend_sched_prefetch_issue(ggml_backend_sched_prefetch * pf, ggml_backend_t gpu, const ggml_backend_sched_prefetch_input * in) {
     ggml_backend_event_wait(pf->copy_backend, pf->freed[in->slot]);
-    ggml_backend_tensor_set_async(pf->copy_backend, in->input_cpy, in->input->data, 0, ggml_nbytes(in->input_cpy));
+
+    const struct ggml_tensor * bank = NULL;
+    const int64_t n_expert = in->input->ne[2];
+    if (pf->lookup != NULL) {
+        pf->slot_of.resize(n_expert);
+        if (!pf->lookup(pf->lookup_user_data, in->input, &bank, pf->slot_of.data()) || bank->nb[2] != in->input->nb[2]) {
+            bank = NULL;
+        }
+    }
+    if (bank == NULL) {
+        ggml_backend_tensor_set_async(pf->copy_backend, in->input_cpy, in->input->data, 0, ggml_nbytes(in->input_cpy));
+        pf->bytes_bus += ggml_nbytes(in->input_cpy);
+    } else {
+        // runs of experts: from the bus where the cache does not hold them, from its slots where it
+        // does, merged where consecutive experts sit in consecutive slots
+        const size_t expert_size = in->input->nb[2];
+        for (int64_t e = 0; e < n_expert;) {
+            const int32_t s = pf->slot_of[e];
+            int64_t n = 1;
+            if (s < 0) {
+                while (e + n < n_expert && pf->slot_of[e + n] < 0) {
+                    n++;
+                }
+                ggml_backend_tensor_set_async(pf->copy_backend, in->input_cpy, (const char *) in->input->data + e*expert_size,
+                    e*expert_size, n*expert_size);
+                pf->bytes_bus += n*expert_size;
+            } else {
+                while (e + n < n_expert && pf->slot_of[e + n] == s + n) {
+                    n++;
+                }
+                struct ggml_tensor from = ggml_backend_sched_prefetch_bytes(bank, (size_t) s*expert_size, n*expert_size);
+                struct ggml_tensor to   = ggml_backend_sched_prefetch_bytes(in->input_cpy, e*expert_size, n*expert_size);
+                ggml_backend_tensor_copy_async(gpu, gpu, &from, &to);
+                pf->bytes_vram += n*expert_size;
+            }
+            e += n;
+        }
+    }
     ggml_backend_event_record(pf->copied[in->slot], pf->copy_backend);
 }
 
