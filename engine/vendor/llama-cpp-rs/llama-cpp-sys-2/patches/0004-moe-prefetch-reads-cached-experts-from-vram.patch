+void ggml_backend_sched_set_moe_prefetch_lookup(ggml_backend_sched_t sched, ggml_backend_sched_moe_prefetch_lookup_t lookup, void * user_data) {
+    GGML_ASSERT(sched);
+    ggml_backend_sched_prefetch * pf = sched->prefetch;
+    if (pf == NULL) {
+        return;
+    }
+    // a diagnostic, to compare: every expert over the bus, as before
+    const char * env = getenv("LLAMA_MOE_PREFETCH_FROM_CACHE");
+    if (lookup != NULL && env != NULL && strcmp(env, "0") == 0) {
+        static bool said = false;
+        if (!said) {
+            fprintf(stderr, "moe prefetch: every expert copied over the bus (LLAMA_MOE_PREFETCH_FROM_CACHE=0)\n");
+            said = true;
+        }
+        lookup = NULL;
+    }
+    pf->lookup           = lookup;
+    pf->lookup_user_data = user_data;
+}
