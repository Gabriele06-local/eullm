diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index 3c225d3..0743af7 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -654,6 +654,28 @@ struct llama_moe_cache::impl {
         return true;
     }
 
+    // the slots of the experts of host tensor src the cache holds, -1 for the others; the slot of a
+    // (layer, expert) is the same in the banks of all of the layer's projections
+    bool lookup(const ggml_tensor * src, const ggml_tensor ** bank, int32_t * slot_of) const {
+        const auto it = binding_of.find(src);
+        if (it == binding_of.end()) {
+            return false;
+        }
+        const binding & b = bindings[it->second];
+        const moe_cache_lru & lru = groups[b.ig].lru;
+        if (src->ne[2] != lru.n_expert) {
+            return false;
+        }
+        const size_t base = (size_t) b.il*lru.n_expert;
+        bool any = false;
+        for (int32_t e = 0; e < lru.n_expert; ++e) {
+            slot_of[e] = lru.slot_of[base + e];
+            any = any || slot_of[e] >= 0;
+        }
+        *bank = b.bank;
+        return any;
+    }
+
     void log_stats() const {
         auto log = [this](const char * name, const stats & st) {
             const size_t n = st.hits + st.misses;
@@ -701,3 +723,7 @@ void llama_moe_cache::sched_begin(void * user_data) {
 bool llama_moe_cache::sched_prepare(void * user_data, void * cache_entry, const int32_t * ids, size_t n_ids, const int32_t ** remapped_ids) {
     return static_cast<llama_moe_cache *>(user_data)->pimpl->prepare(static_cast<const impl::binding *>(cache_entry), ids, n_ids, remapped_ids);
 }
+
+bool llama_moe_cache::sched_lookup(void * user_data, const ggml_tensor * src, const ggml_tensor ** bank, int32_t * slot_of) {
+    return static_cast<llama_moe_cache *>(user_data)->pimpl->lookup(src, bank, slot_of);
+}
