+#ifdef USE_CUDA_GRAPH
+// Drops every CUDA graph of cuda_ctx when a legacy pool of its device freed its
+// cached buffers since the last call: the graphs hold the addresses of pool
+// temporaries, and replaying one into freed memory computed NaN, or faulted
+// (HSA_STATUS_ERROR_MEMORY_APERTURE_VIOLATION on ROCm), from then on. The
+// graphs are captured again on the next calls.
+static void ggml_cuda_graphs_after_pool_flush(ggml_backend_cuda_context * cuda_ctx) {
+    static std::mutex mutex;
+    static std::unordered_map<const ggml_backend_cuda_context *, uint64_t> seen;
+    const uint64_t flushes = ggml_cuda_pool_flushes[cuda_ctx->device].load(std::memory_order_relaxed);
+    bool drop = false;
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        uint64_t & last = seen[cuda_ctx];
+        drop = last != flushes;
+        last = flushes;
+    }
+    if (drop && !cuda_ctx->cuda_graphs.empty()) {
+        CUDA_CHECK(cudaStreamSynchronize(cuda_ctx->stream()));
+        cuda_ctx->cuda_graphs.clear();
+    }
+}
+#endif // USE_CUDA_GRAPH
+
 static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend, ggml_cgraph * cgraph) {
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
 
@@ -4554,6 +4625,8 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
     const void * graph_key = nullptr;
 
 #ifdef USE_CUDA_GRAPH
+    ggml_cuda_graphs_after_pool_flush(cuda_ctx);
+
     graph_key = ggml_cuda_graph_get_key(cgraph);
 
     ggml_cuda_graph_set_enabled(cuda_ctx, graph_key);
