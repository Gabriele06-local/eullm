+// Runs fn(j) for each of the n_bufs devices, each on a thread of its own when
+// the copy is large: every device has its own link to the host, and one
+// thread going through them in turn left all but one idle while a weight
+// loaded (a tensor-split load of Qwen3-235B over four MI250X GCDs took 352 s
+// with the rows gathered, against 113 s split by layer). Each thread copies
+// to its own device on its own stream (cudaStreamPerThread), and the split
+// state is computed before. GGML_META_SET_THREADS=0 copies one device after
+// the other, as before.
+template <typename F>
+static void ggml_backend_meta_for_each_buf(size_t n_bufs, size_t size, F && fn) {
+    static const bool threads_on = [] {
+        const char * env = getenv("GGML_META_SET_THREADS");
+        return env == nullptr || atoi(env) != 0;
+    }();
+    if (!threads_on || n_bufs <= 1 || size < (size_t(16) << 20)) {
+        for (size_t j = 0; j < n_bufs; j++) {
+            fn(j);
+        }
+        return;
+    }
+    std::vector<std::thread> threads;
+    threads.reserve(n_bufs);
+    for (size_t j = 0; j < n_bufs; j++) {
+        threads.emplace_back([&fn, j] { fn(j); });
+    }
+    for (std::thread & t : threads) {
+        t.join();
+    }
+}
