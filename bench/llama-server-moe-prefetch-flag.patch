common : a --moe-prefetch flag for llama-server, to run the prefetch (EuLLM patches 0003 and 0004) from the command line in benchmarks. Bench-only: the engine does not apply it.

--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -2787,6 +2787,16 @@
         }
     ).set_env("LLAMA_ARG_MOE_CACHE_MIB"));
     add_opt(common_arg(
+        {"--moe-prefetch"}, "N",
+        "VRAM slots (2 to 8) to copy the experts kept in the CPU of a large batch ahead on a second stream (default: 0, disabled)",
+        [](common_params & params, int value) {
+            if (value != 0 && (value < 2 || value > 8)) {
+                throw std::invalid_argument("invalid value, 0 or 2 to 8");
+            }
+            params.moe_prefetch_slots = value;
+        }
+    ).set_env("LLAMA_ARG_MOE_PREFETCH"));
+    add_opt(common_arg(
         {"-ncffn", "--n-cpu-ffn"}, "N",
         "keep the dense FFN weights of the first N layers in the CPU\n"
