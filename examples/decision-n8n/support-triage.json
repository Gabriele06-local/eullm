              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "48db8ef4-132d-553f-891a-ca978ada8661",
                    "leftValue": "={{ $json.answers.person.noul }}",
                    "rightValue": 0.5,
