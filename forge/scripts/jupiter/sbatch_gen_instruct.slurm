#!/bin/bash
# Instruction/answer pairs from the legislation corpus, generated by EULLM
# Engine on one GH200 node: deliverable 5 of EHPC-AIF-2026PG01-1434, "a faster
# inference backend for synthetic data generation", against the 58-64 tok/s
# of plain Transformers on Leonardo with the same model,
# Qwen3-30B-A3B-Instruct-2507 (Apache 2.0, no clause on training with its
# output; here its Q8_0 GGUF, 32.5 GB).
#
# One `eullm serve` a GPU, each with 32 slots, and generate_instructions.py
# sending its conversations to the four at once (--backend eullm). The
# pairs are grounded in passages of the training split only (never val),
# and the driver's filters are Leonardo's. Resumable: every result is
# appended with its key, and a rerun skips the keys on disk.
#
#     eullm && sbatch --account e-aif-2026pg01-1434 \
#         --output="$PROJECT/$USER/forge/runs/logs/gen-instruct-%j.out" \
#         forge/scripts/jupiter/sbatch_gen_instruct.slurm
#
# Needs, from a login node: the model in the engine's store
# (`$EULLM_BIN pull hf.co/unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:Q8_0`) and
# the corpus ($FORGE_DATA_DIR/norms/train.jsonl, make_norms_split.py).
# Whole node: 4 GPU-hours an hour; the driver stops itself before the end.

#SBATCH --job-name=forge-gen-instruct
#SBATCH --partition=booster
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --time=01:00:00

set -uo pipefail
EULLM_REPO="${EULLM_REPO:-$SLURM_SUBMIT_DIR}"
# shellcheck source=env.sh
source "$EULLM_REPO/forge/scripts/jupiter/env.sh"
export EULLM_MODELS_DIR="${EULLM_MODELS_DIR:-$PROJECT/$USER/eullm-models}"
EULLM_BIN="${EULLM_BIN:-$PROJECT/$USER/eullm-target/next10/release/eullm}"
CORPUS="${FORGE_GEN_CORPUS:-$FORGE_DATA_DIR/norms/train.jsonl}"
OUT="${FORGE_GEN_OUT:-$FORGE_DATA_DIR/norms-instruct/pairs.jsonl}"
LIMIT="${FORGE_GEN_LIMIT:-20000}"
STOP_MIN="${FORGE_GEN_STOP_MIN:-52}"
SEEDS="${FORGE_GEN_SEEDS:-0}"
JOB="${SLURM_JOB_ID:-local}"
PORT=$((18500 + ${SLURM_JOB_ID:-0} % 200))
LOGS="$FORGE_RUN_DIR/gen-instruct-$JOB"
mkdir -p "$LOGS" "$(dirname "$OUT")" "$FORGE_RUN_DIR/power"
export EULLM_AUDIT_DIR="$LOGS/audit"

echo "=== instruction pairs with EULLM Engine: job $JOB on $(hostname), $(date -Is) ==="
echo "  engine $("$EULLM_BIN" --version 2>&1 | head -1) ($EULLM_BIN)"
echo "  corpus $CORPUS -> $OUT, up to $LIMIT pairs a seed (seeds $SEEDS), stop after $STOP_MIN min"
[ -f "$CORPUS" ] || { echo "[!!] no corpus $CORPUS"; exit 1; }
MODEL=$("$EULLM_BIN" list 2>/dev/null | awk 'tolower($1) ~ /30b-a3b-instruct-2507/ && !/file missing/ { print $1; exit }')
[ -n "$MODEL" ] || { echo "[!!] Qwen3-30B-A3B-Instruct-2507 is not in $EULLM_MODELS_DIR: pull it on a login node"; exit 1; }
echo "  model $MODEL"

nvidia-smi --query-gpu=timestamp,index,power.draw,utilization.gpu,memory.used \
    --format=csv,noheader,nounits -l 5 >"$FORGE_RUN_DIR/power/gen-instruct-$JOB.csv" 2>/dev/null &
SAMPLER=$!

# One server a GPU, 32 slots of 4,096 tokens: a passage of up to 5,000
# characters, the prompt and up to 1,024 new tokens fit. --mmap: the model is
# on GPFS, where reading it in is the slow way (docs/jupiter/allocation-plan.md;
# engines from ca0d19d on map it by themselves).
SERVERS=() URLS=()
for g in 0 1 2 3; do
    CUDA_VISIBLE_DEVICES=$g taskset -c "$((72 * g))-$((72 * g + 71))" \
        "$EULLM_BIN" serve --port $((PORT + g)) --batch-size 32 --ctx-size 131072 --mmap \
        >"$LOGS/server$g.log" 2>&1 &
    SERVERS+=($!)
    URLS+=("http://127.0.0.1:$((PORT + g))")
done
stop_servers() { for p in "${SERVERS[@]}"; do kill "$p" 2>/dev/null; done; wait "${SERVERS[@]}" 2>/dev/null; }
for g in 0 1 2 3; do
    for _ in $(seq 1 300); do
        curl -sf "${URLS[$g]}/api/version" >/dev/null 2>&1 && break
        kill -0 "${SERVERS[$g]}" 2>/dev/null || break
        sleep 1
    done
done
# Load the model on every server before the clock of the driver starts.
t0=$(date +%s)
WARM=()
for g in 0 1 2 3; do
    curl -s -m 600 "${URLS[$g]}/api/chat" -H 'Content-Type: application/json' \
        -d "{\"model\": \"$MODEL\", \"messages\": [{\"role\": \"user\", \"content\": \"Ciao.\"}], \"stream\": false, \"options\": {\"num_predict\": 4}}" \
        >"$LOGS/warmup$g.json" 2>&1 &
    WARM+=($!)
done
wait "${WARM[@]}"
echo "  four servers loaded in $(( $(date +%s) - t0 )) s"
for g in 0 1 2 3; do
    grep -q '"done"' "$LOGS/warmup$g.json" ||
        { echo "[!!] server $g did not answer: tail $LOGS/server$g.log"; tail -5 "$LOGS/server$g.log"; stop_servers; exit 1; }
done

# One pass a seed: a seed picks one task and one window of every passage,
# so another seed asks other questions of the same corpus. Pairs already on
# disk (same passage, same task) are skipped by their key.
RC=0
start=$(date +%s)
for seed in $SEEDS; do
    left=$(( STOP_MIN - ($(date +%s) - start) / 60 ))
    [ "$left" -ge 3 ] || { echo "  no time left for seed $seed"; break; }
    echo "--- seed $seed, at most $left min"
    python "$EULLM_REPO/forge/scripts/generate_instructions.py" \
        --backend eullm --servers "$(IFS=,; echo "${URLS[*]}")" --model "$MODEL" \
        --concurrency 128 --batch-size 256 --max-new-tokens 1024 --seed "$seed" \
        --corpus "$CORPUS" --out "$OUT" --limit "$LIMIT" --stop-after-min "$left" || RC=$?
done

stop_servers
kill "$SAMPLER" 2>/dev/null
wait "$SAMPLER" 2>/dev/null
echo
echo "  pairs on disk: $(wc -l <"$OUT" 2>/dev/null || echo 0) accepted, $(wc -l <"$OUT.rejected.jsonl" 2>/dev/null || echo 0) rejected"
python "$EULLM_REPO/forge/scripts/jupiter/energy.py" "$FORGE_RUN_DIR/power/gen-instruct-$JOB.csv" --interval 5
echo "=== done $(date -Is) (driver exit $RC) ==="
exit "$RC"
