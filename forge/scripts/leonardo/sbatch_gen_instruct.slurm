#!/bin/bash
# Stage 3 data — instruction/answer pairs from the legal corpus, generated by
# Qwen3-30B-A3B-Instruct-2507. What and why: forge/eullm_forge/datasets/
# instruct_gen.py. This is only the resource request around the driver.
#
# START WITH THE PILOT, which is the default: 60 pairs. It answers the two
# questions that decide whether the full run is worth its node-hours — how
# many pairs survive the filters, and how many tokens a second this backend
# gets — before anything is spent on thousands. Read the log's last line and
# a few pairs, then raise GEN_LIMIT:
#
#   sbatch forge/scripts/leonardo/sbatch_gen_instruct.slurm
#   sbatch --export=ALL,GEN_LIMIT=6000 forge/scripts/leonardo/sbatch_gen_instruct.slurm
#
# The full run is the SAME command with a larger limit: jobs are derived from
# the seed, so the pilot's 60 are the first 60 of the 6000 and are skipped,
# and a link killed by the walltime is resumed by submitting it again.
#
# Settable:
#   GEN_LIMIT   pairs attempted (default 60, the pilot)
#   GEN_BATCH   batch size (default 48)
#   GEN_OUT     output JSONL (default $WORK/eullm_runs/stage3/instruct-pairs-v2.jsonl)
#   GEN_REPO    checkout to run (default: the one this file was submitted from)
#
# THE PILOT OF 24 SEPTEMBER (job 58559305, 60 pairs, first prompt) said:
#   * 78 % accepted, 58 tok/s at batch 16 with the GPUs at 30-45 % and 27 of
#     64 GB used per card — memory-bound it was not, so the batch is 48 now.
#     Even unchanged, 6,000 pairs would be ~7-8 node-hours.
#   * one closed-book question in three samples was about ONE case ("the
#     appeal against the Bari ruling of 15 January 2024…"), unanswerable
#     except by invention; and one answer carried a defendant's surname
#     inside a case citation. Both are now filtered (instruct_gen.py), and
#     the output file is new — v2 — so pairs from the first prompt, which
#     had neither filter, are not mixed into the training set.
#
# Same geometry as the split arm — 3 GPUs, 24 cores, 340 GB, two hours —
# because it is the one measured to be placed quickly (see
# sbatch_phase2_split.slurm). 61 GB of bf16 weights over three 64 GB cards
# leaves each about 40 GB for the KV cache of a batch.
#
#SBATCH --job-name=eullm-gen-instruct
#SBATCH --partition=boost_usr_prod
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
#SBATCH --gres=gpu:3
#SBATCH --mem=340G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x-%j.out

set -uo pipefail

# The checkout is the one this file was submitted from, not $EULLM_REPO —
# the lesson of the curve job, which once ran another tree's code.
SELF="$(scontrol show job "${SLURM_JOB_ID:-0}" 2>/dev/null |
        sed -n 's/.*Command=\([^ ]*\).*/\1/p' | head -1)"
if [ -n "${GEN_REPO:-}" ]; then
    REPO="$GEN_REPO"
elif [ -n "$SELF" ] && [ -f "$SELF" ]; then
    REPO="$(cd "$(dirname "$SELF")/../../.." && pwd)"
else
    REPO="${EULLM_REPO:-$WORK/eullm}"
fi

# shellcheck disable=SC1091
source "$REPO/forge/scripts/leonardo/env.sh"

LIMIT="${GEN_LIMIT:-60}"
BATCH="${GEN_BATCH:-48}"
OUT="${GEN_OUT:-$WORK/eullm_runs/stage3/instruct-pairs-v2.jsonl}"
CORPUS="$EULLM_DATA_DIR/train.jsonl"
MODEL="Qwen/Qwen3-30B-A3B-Instruct-2507"

echo "[gen] repo   $REPO"
echo "[gen] commit $(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo '?')"
echo "[gen] limit  $LIMIT, batch $BATCH"
echo "[gen] out    $OUT"

# Pre-flight before the 61 GB load, not after it.
[ -f "$CORPUS" ] || { echo "[gen] no corpus at $CORPUS" >&2; exit 1; }
python - "$MODEL" <<'EOF' || exit 1
import sys
from huggingface_hub import snapshot_download
try:
    snapshot_download(sys.argv[1], local_files_only=True)
except Exception as exc:
    print(f"[gen] {sys.argv[1]} is not in the offline cache ({type(exc).__name__}).\n"
          "[gen] Prefetch it from a LOGIN node first:\n"
          "[gen]   python forge/scripts/leonardo/prefetch_models.py "
          f"--models {sys.argv[1]}", file=sys.stderr)
    sys.exit(1)
EOF
mkdir -p "$(dirname "$OUT")"

# shellcheck disable=SC1091
source "$REPO/forge/scripts/leonardo/heartbeat.sh"
heartbeat_start

# Stop ten minutes before the walltime so the last batch is written, not
# killed halfway.
python "$REPO/forge/scripts/generate_instructions.py" \
    --corpus "$CORPUS" --out "$OUT" --model "$MODEL" \
    --limit "$LIMIT" --batch-size "$BATCH" --stop-after-min 110
