# Exception: engine/vendor/ tracks vendored Rust crates (llama-cpp-rs fork
# pinned to the gemma4uv-capable llama.cpp commit). See engine/vendor/README.
!engine/vendor/
!engine/vendor/**

# Datasets / corpora (GDPR-sensitive, never commit)
*.jsonl
*.parquet
*.arrow
/data/
/datasets/

# Exception: eval-harness seed sets are small, curated, PII-free source assets
# (not training corpora) — keep them tracked so CI and wheels include them.
!forge/eullm_forge/eval/data/*.jsonl
/corpus/
/corpora/
italgiure_corpus/
legal_it_corpus/
_progress.json

# Engine binaries downloaded from GitHub releases
/eullm
/eullm-tq

# ReflexBench reports written where it is run (bench/reflexbench/)
reflexbench-*.json
ragbench-*.json

# Local clutter moved out of the repo root (reports, binaries, models, media)
/artifacts/
# The LUMI campaign summaries are kept (bench/results/lumi/README.md)
!bench/results/lumi/*.csv

# Private evaluation sets and the answers that repeat their questions: never
# in the repository, never online (they stay on the clusters' private dirs).
lexia-trappole*
*lexia*.jsonl
private-eval/
teacher-eval/
